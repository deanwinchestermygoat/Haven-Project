[sub_resource type="GDScript" id="GDScript_5h13y"]
resource_name = "First"
script/source = "extends RichTextLabel
var text_number = -1
var click_state = false
var waiting_for_choice = false
@onready var text_box: TextureRect = $\"../Text Box\"
@onready var rich_text_label: RichTextLabel = $\".\"
@onready var button: Button = $\"../Button\"
@onready var button_2: Button = $\"../Button2\"
@onready var andrew_image: TextureRect = $\"../TextureRect2\"
@onready var chef_image: TextureRect = $\"../TextureRect3\"
var text_content1: Array = [
	\"Andrew: Next on the agenda.. Let's get some eggs!\",
	\"Andrew: Should be some in the fridge if I'm not mistaken- but where'd I leave them?\",
	\"next_scene\",
	]
var speaker_name = \"Andrew:\"
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	button.hide()
	button_2.hide()
	andrew_image.hide()
	chef_image.hide()


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if Input.is_action_just_pressed(\"leftclick\") and not waiting_for_choice:
		click_state = not click_state
	if click_state == true:
		text_number+=1
		click_state = not click_state
		if text_number>=text_content1.size():
			rich_text_label.hide()
			text_box.hide()
			andrew_image.hide()
			chef_image.hide()
			text_number = 0
		else:
			text = text_content1[text_number]
			speaker_name = text_content1[text_number].get_slice(\" \", 0)
			if speaker_name == \"Andrew:\":
				chef_image.hide()
				andrew_image.show()
			elif speaker_name == \"Chef:\":
				andrew_image.hide()
				chef_image.show()
			elif speaker_name == \"next_scene\":
				get_tree().change_scene_to_file(\"res://QTE2.tscn\")
	
		
	
"

