[sub_resource type="GDScript" id="GDScript_xwgne"]
script/source = "extends RichTextLabel
var text_number = 0
var click_state = false
@onready var text_box: TextureRect = $\"../Text Box\"
@onready var rich_text_label: RichTextLabel = $\".\"
@onready var button: Button = $\"../Button\"
@onready var button_2: Button = $\"../Button2\"
@onready var andrew_image: TextureRect = $\"../TextureRect2\"
@onready var chef_image: TextureRect = $\"../TextureRect3\"
var text_content1: Array[String] = [
		\"Andrew: So.. what was that?\",
		\"Chef: What was what?\",
		\"Andrew: How'd you win a baking competition with SOUP?\",
		\"Chef: Your cake was just that bad. Maybe you should stick to microwaving instant ramen.\",
		\"[exit_chef]\",
		\"Andrew: Wow. I guess I just have to bake the best cake in the world to prove him wrong!\",
		\"Andrew: Now where to start…\",
		\"[fade_kitchen]\",
		\"Andrew: So it says right here.. Best cake recipes for experienced bakers.\",
		\"Andrew: I'm an experienced baker right?\",
		\"[choice]\",
	]
var speaker_name = \"\"
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	button.hide()
	button_2.hide()
	


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if Input.is_action_just_pressed(\"leftclick\"):
		click_state = not click_state
	if click_state == true:
		text_number+=1
		click_state = not click_state
		if text_number>3:
			rich_text_label.hide()
			text_box.hide()
			andrew_image.hide()
			chef_image.hide()
			text_number = 0
		else:
			text = text_content1[text_number]
			speaker_name = text_content1[text_number].get_slice(\" \", 0)
			if speaker_name == \"Andrew:\":
				chef_image.hide()
				andrew_image.show()
			elif speaker_name == \"Chef:\":
				andrew_image.hide()
				chef_image.show()
			else:
				andrew_image.hide()
				chef_image.hide()

	
		
	
"

